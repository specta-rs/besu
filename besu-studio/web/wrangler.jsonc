{
  // The hosted copy of the studio: the same bundle the binary embeds, with no Rust
  // server behind it. The page connects to a local `besu studio` and falls back to
  // fixture data. `wrangler deploy` uploads `dist` as static assets only, so this
  // Worker never runs code.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "besu-studio",
  "compatibility_date": "2025-12-31",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "studio.besu.specta.dev", "custom_domain": true }]
}
